# Notion integration token with read access to the 云梯Blog data source.
NOTION_TOKEN=
NOTION_DATA_SOURCE_ID=268b4eb6-c211-8193-96cd-000b1cfb7b9a

# Notion webhook signature verification token. This is produced during the
# webhook subscription verification flow.
NOTION_WEBHOOK_VERIFICATION_TOKEN=

# A long random secret used to authorize manual/internal synchronization.
# Example generation command: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SYNC_TOKEN=

# Optional debounce time for merging multiple Notion webhook events.
SYNC_DEBOUNCE_MS=5000

# Site settings used when rendering pages and RSS.
SITE_URL=https://your-site.netlify.app
SITE_NAME=云梯笔记
